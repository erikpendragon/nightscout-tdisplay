# Never commit real credentials - secrets.yaml is yours alone
secrets.yaml

# ESPHome build output
.esphome/
*.bin
*.elf
# ...but the released firmware DOES belong in the repo - it is what GitHub
# Pages serves as the update channel, and *.bin above would silently drop it.
!docs/**/*.bin
!docs/*.bin

# Editors / OS
.DS_Store
*.swp

# Second layer of defence. Anything about the incident, the support ticket,
# or a real person's data lives in ../cgm-private/ and must never land here.
*SUPPORT*
*TICKET*
*AUDIT*
*ASSUMPTIONS*
*HANDOFF*
VA-EXPLANATION*
cgm-private/

# Generated by build-webui.sh (ESPHome's UI bundle + cgm-ui.js). ~230 KB of
# vendored upstream code; rebuild it rather than commit it.
web-ui.js

# Local secrets used only to check release binaries. Never commit.
.release-denylist
